# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.log

# Node, if a build ever needs it
node_modules/

# Client work stays local. Every build folder is git-ignored except the keep
# marker, because builds/ holds real business facts, real assets, and real
# client conversations - none of which belong in a public fork.
builds/*/
!builds/.gitkeep

# Local scratch
tmp/
sites/

# Your own stage-00 answers, including your name and email. config.example.md is
# the shipped template; this is the filled-in copy and it is yours, not the
# repo's. On a fork where a team genuinely wants one shared set of defaults,
# delete this line and commit it.
config.md

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.log

# Node, if a build ever needs it
node_modules/

# Client work stays local. Every build folder is git-ignored except the keep
# marker, because builds/ holds real business facts, real assets, and real
# client conversations - none of which belong in a public fork.
builds/*/
!builds/.gitkeep

# Local scratch
tmp/
sites/
